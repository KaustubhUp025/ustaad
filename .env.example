# Copy to backend/.env for local runs. Never commit real values. Real secrets live in Secret Manager.
GOOGLE_CLOUD_PROJECT=ustaad-xxxx
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_GENAI_USE_VERTEXAI=TRUE
FIRESTORE_DB=(default)
FLASH_MODEL=gemini-3.8-flash
LIVE_MODEL=gemini-3.8-live
TTS_MODEL=gemini-3.8-flash-tts
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
LIVE_LOCATION=us-central1
TRANSCRIBE_MODEL=
AGENT_ENGINE_ID=
AGENT_SEARCH_DATASTORE=
MEDIA_BUCKET=ustaad-xxxx-media
ALLOWED_ORIGINS=http://localhost:5173
DEMO_SAFE=0
# Seconds of artificial delay before each Flash photo check, to test the demo-safe fallback (T27)
DEMO_MODEL_DELAY_S=0
MOCK_LIVE=0
# Vendor quotes bot from @BotFather (Secret Manager `tg-bot-token`) and the webhook's shared secret (`tg-webhook-secret`)
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=
# Signs demo session tokens; any long random string locally (Secret Manager `session-secret` on Cloud Run)
SESSION_SECRET=
PLACES_API_KEY=
