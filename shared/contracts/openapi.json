{
  "components": {
    "schemas": {
      "AudioUrlRequest": {
        "additionalProperties": false,
        "properties": {
          "uri": {
            "title": "Uri",
            "type": "string"
          }
        },
        "required": [
          "uri"
        ],
        "title": "AudioUrlRequest",
        "type": "object"
      },
      "AudioUrlResponse": {
        "additionalProperties": false,
        "properties": {
          "expires_in": {
            "const": 900,
            "title": "Expires In",
            "type": "integer"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "expires_in"
        ],
        "title": "AudioUrlResponse",
        "type": "object"
      },
      "DemoSessionRequest": {
        "additionalProperties": false,
        "properties": {
          "worker_id": {
            "default": "w_hi_demo",
            "title": "Worker Id",
            "type": "string"
          }
        },
        "title": "DemoSessionRequest",
        "type": "object"
      },
      "DemoSessionResponse": {
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          },
          "worker": {
            "$ref": "#/components/schemas/Worker"
          },
          "ws_url": {
            "title": "Ws Url",
            "type": "string"
          }
        },
        "required": [
          "token",
          "worker",
          "ws_url"
        ],
        "title": "DemoSessionResponse",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "bad_request",
              "unauthorized",
              "forbidden",
              "not_found",
              "conflict",
              "validation_error",
              "rate_limited",
              "internal_error",
              "http_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Geo": {
        "additionalProperties": false,
        "properties": {
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "title": "Lng",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "title": "Geo",
        "type": "object"
      },
      "InventoryDelta": {
        "additionalProperties": false,
        "properties": {
          "delta": {
            "title": "Delta",
            "type": "integer"
          },
          "part": {
            "pattern": "\\S",
            "title": "Part",
            "type": "string"
          }
        },
        "required": [
          "part",
          "delta"
        ],
        "title": "InventoryDelta",
        "type": "object"
      },
      "InventoryDeltaRequest": {
        "additionalProperties": false,
        "properties": {
          "deltas": {
            "items": {
              "$ref": "#/components/schemas/InventoryDelta"
            },
            "minItems": 1,
            "title": "Deltas",
            "type": "array"
          }
        },
        "required": [
          "deltas"
        ],
        "title": "InventoryDeltaRequest",
        "type": "object"
      },
      "InventoryItem": {
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Aliases",
            "type": "array"
          },
          "category": {
            "anyOf": [
              {
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "id": {
            "pattern": "^part_\\S+$",
            "title": "Id",
            "type": "string"
          },
          "min_qty": {
            "minimum": 0.0,
            "title": "Min Qty",
            "type": "integer"
          },
          "name": {
            "pattern": "\\S",
            "title": "Name",
            "type": "string"
          },
          "qty": {
            "minimum": 0.0,
            "title": "Qty",
            "type": "integer"
          },
          "source": {
            "enum": [
              "voice",
              "photo",
              "manual"
            ],
            "title": "Source",
            "type": "string"
          },
          "unit_cost_inr": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Cost Inr"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "aliases",
          "qty",
          "min_qty",
          "unit_cost_inr",
          "source",
          "updated_at"
        ],
        "title": "InventoryItem",
        "type": "object"
      },
      "InventoryListResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/InventoryItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "InventoryListResponse",
        "type": "object"
      },
      "MediaUploadHeaders": {
        "additionalProperties": false,
        "properties": {
          "Content-Type": {
            "title": "Content-Type",
            "type": "string"
          },
          "x-goog-content-length-range": {
            "title": "X-Goog-Content-Length-Range",
            "type": "string"
          }
        },
        "required": [
          "Content-Type",
          "x-goog-content-length-range"
        ],
        "title": "MediaUploadHeaders",
        "type": "object"
      },
      "MediaUploadRequest": {
        "additionalProperties": false,
        "properties": {
          "content_type": {
            "minLength": 1,
            "title": "Content Type",
            "type": "string"
          },
          "filename": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          },
          "import_id": {
            "anyOf": [
              {
                "pattern": "^i_[A-Za-z0-9][A-Za-z0-9_-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Import Id"
          },
          "job_id": {
            "anyOf": [
              {
                "pattern": "^j_[A-Za-z0-9][A-Za-z0-9_-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "kind": {
            "enum": [
              "photo",
              "video",
              "import"
            ],
            "title": "Kind",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "pattern": "^r_[A-Za-z0-9]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "kind",
          "content_type"
        ],
        "title": "MediaUploadRequest",
        "type": "object"
      },
      "MediaUploadResponse": {
        "additionalProperties": false,
        "properties": {
          "expires_in": {
            "const": 900,
            "title": "Expires In",
            "type": "integer"
          },
          "headers": {
            "$ref": "#/components/schemas/MediaUploadHeaders"
          },
          "upload_url": {
            "title": "Upload Url",
            "type": "string"
          },
          "uri": {
            "title": "Uri",
            "type": "string"
          }
        },
        "required": [
          "upload_url",
          "uri",
          "expires_in",
          "headers"
        ],
        "title": "MediaUploadResponse",
        "type": "object"
      },
      "Worker": {
        "additionalProperties": false,
        "properties": {
          "brands": {
            "items": {
              "type": "string"
            },
            "title": "Brands",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "demo": {
            "title": "Demo",
            "type": "boolean"
          },
          "experience_yrs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Experience Yrs"
          },
          "geo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Geo"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "pattern": "^w_\\S+$",
            "title": "Id",
            "type": "string"
          },
          "lang": {
            "enum": [
              "hi",
              "te",
              "ta",
              "bn",
              "en"
            ],
            "title": "Lang",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "onboarding_done": {
            "title": "Onboarding Done",
            "type": "boolean"
          },
          "pincode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pincode"
          },
          "skill_gaps": {
            "items": {
              "type": "string"
            },
            "title": "Skill Gaps",
            "type": "array"
          },
          "trades": {
            "items": {
              "enum": [
                "ac",
                "fridge",
                "washing_machine",
                "led_tv",
                "microwave",
                "geyser",
                "fan_cooler",
                "other"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Trades",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "lang",
          "trades",
          "brands",
          "pincode",
          "geo",
          "experience_yrs",
          "onboarding_done",
          "skill_gaps",
          "demo",
          "created_at"
        ],
        "title": "Worker",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
